{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wgtechlabs/ph-scam-db/schemas/report.schema.json",
  "title": "PH Scam DB report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "categories",
    "status",
    "firstReportedAt",
    "lastReportedAt",
    "reportCount",
    "references"
  ],
  "properties": {
    "number": {
      "type": "string",
      "pattern": "^\\+639\\d{9}$",
      "description": "Philippine mobile number in E.164 format"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "advance-fee",
          "fake-delivery",
          "impersonation",
          "investment",
          "loan",
          "phishing-sms",
          "robocall",
          "spam",
          "other"
        ]
      }
    },
    "status": {
      "enum": ["reported", "watchlist", "confirmed"]
    },
    "firstReportedAt": {
      "type": "string",
      "format": "date"
    },
    "lastReportedAt": {
      "type": "string",
      "format": "date"
    },
    "reportCount": {
      "type": "integer",
      "minimum": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": {
            "enum": ["github-issue", "government-advisory", "news-report", "maintainer-review"]
          },
          "id": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "string", "minLength": 1, "maxLength": 200 }
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Sanitized, non-identifying context"
    },
    "expiresAt": {
      "type": "string",
      "format": "date"
    }
  }
}
